# Server Configuration
PORT=3001

# Gemini API Key (Server-side ONLY; do NOT prefix with VITE_)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
# On Render, set this in the dashboard Environment tab (repo .env files are not uploaded).
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: public HTTPS origin of the Express API when the UI is hosted separately (Vercel).
# Do not set this to http://localhost:10000 — that is only the Render process bind address.
# VITE_BACKEND_API_URL=https://beyond-the-score.onrender.com

